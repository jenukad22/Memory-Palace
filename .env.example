# Optional Supabase sync. Copy to `.env` and fill in to enable it.
#
# WITHOUT these two variables the app is exactly the local-first app it is
# today: no settings entry, no client constructed, no network code reached.
# Sync is additive — see docs/superpowers/specs/2026-07-31-supabase-sync-design.md §4.
#
# Server setup: run docs/supabase-schema.sql once in the Supabase SQL editor.
#
# The anon key is publishable by design and is safe in a client bundle.
# Row-level security is the actual boundary — never this key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
